{
  "name": "easy-replace-in-files",
  "version": "2.0.0",
  "description": "CLI to find and replace in files via a JSON config. Supports globs, regex, and placeholders (e.g. $$package__version$$, $$ENV_VAR$$). Great for version bumps and build-time replacements.",
  "keywords": [
    "replace",
    "find-replace",
    "search-replace",
    "cli",
    "config",
    "glob",
    "regex",
    "placeholders",
    "version-bump",
    "build"
  ],
  "files": [
    "index.js",
    "src",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/ernilambar/easy-replace-in-files#readme",
  "bugs": {
    "url": "https://github.com/ernilambar/easy-replace-in-files/issues"
  },
  "license": "MIT",
  "author": "Nilambar Sharma <nilambar@outlook.com> (https://github.com/ernilambar)",
  "main": "index.js",
  "type": "module",
  "bin": {
    "easy-replace-in-files": "index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernilambar/easy-replace-in-files.git"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "minimist": "^1.2.8",
    "read-package-up": "^12.0.0",
    "replace-in-file": "^9.0.0",
    "unixify": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "neostandard": "^0.14.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
